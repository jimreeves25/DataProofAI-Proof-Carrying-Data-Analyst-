# Copy this template to .env and add real credentials only in .env.
OPENAI_API_KEY=AQ.Ab8RN6ITONvi4v10cu4d4BfUaoP-d2P_rPxk3KEJzsHijAHcCg
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/DATABASE

# LLM Configuration
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60.0
LLM_MAX_RETRIES=3

# Analysis Pipeline
MAX_REPLAN_ATTEMPTS=3
EXECUTION_TIMEOUT_SECONDS=30.0

# Sandbox (set USE_DOCKER=true in production)
USE_DOCKER=false
DOCKER_IMAGE=python-sandbox:latest
DOCKER_MEMORY_LIMIT=256m
DOCKER_CPU_LIMIT=0.5
